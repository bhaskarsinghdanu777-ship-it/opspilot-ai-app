# ==============================================================================
# OpsPilot AI — Production Environment Configuration (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER-SIDE SECRETS (STRICTLY PRIVATE — NEVER EXPOSE TO BROWSER / VITE_)
# ------------------------------------------------------------------------------

# GEMINI_API_KEY: Secret API key for Google Gemini 3.8 Flash models.
# Handled exclusively by the server (server.ts) to execute AI analysis pipelines.
# Example: AIzaSyD...
GEMINI_API_KEY=

# PORT: The port the backend server listens on in production (Google Cloud Run sets this automatically to 8080 or 3000).
# Example: 3000
PORT=3000

# NODE_ENV: Application environment mode ("development" or "production").
# When "production", server serves compiled static SPA files from dist/.
# Example: production
NODE_ENV=production


# ------------------------------------------------------------------------------
# 2. CLIENT-SIDE PUBLIC CONFIGURATION (SAFE TO EXPOSE VIA VITE_ PREFIX)
# ------------------------------------------------------------------------------

# APP_URL: The public URL where this applet is hosted (e.g. Cloud Run URL).
# Example: https://opspilot-ai-xyz-uc.a.run.app
APP_URL=

# VITE_FIREBASE_API_KEY: Firebase Web API Key for client-side Auth and Firestore.
# Example: AIzaSyC...
VITE_FIREBASE_API_KEY=

# VITE_FIREBASE_AUTH_DOMAIN: Firebase Authentication domain.
# Example: my-applet-project.firebaseapp.com
VITE_FIREBASE_AUTH_DOMAIN=

# VITE_FIREBASE_PROJECT_ID: Google Cloud / Firebase Project ID.
# Example: my-applet-project
VITE_FIREBASE_PROJECT_ID=

# VITE_FIREBASE_STORAGE_BUCKET: Firebase Storage bucket identifier.
# Example: my-applet-project.firebasestorage.app
VITE_FIREBASE_STORAGE_BUCKET=

# VITE_FIREBASE_MESSAGING_SENDER_ID: Firebase Cloud Messaging sender ID.
# Example: 123456789012
VITE_FIREBASE_MESSAGING_SENDER_ID=

# VITE_FIREBASE_APP_ID: Firebase Web Application ID.
# Example: 1:123456789012:web:abcdef123456
VITE_FIREBASE_APP_ID=

# VITE_FIREBASE_FIRESTORE_DATABASE_ID: Firestore Database identifier (use "(default)" or named database).
# Example: ai-studio-opspilotai-9f7f4000-9035-4944-aea4-e3f838f3a3cb
VITE_FIREBASE_FIRESTORE_DATABASE_ID=

# VITE_API_BASE_URL: Optional external backend API URL (e.g., Cloud Run or custom Express host).
# Leave empty to use relative /api paths (handled automatically by Netlify Functions or local server).
# Example: https://opspilot-api.run.app
VITE_API_BASE_URL=

